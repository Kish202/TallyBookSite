{
  "name": "tallybook",
  "version": "0.1.0",
  "description": "A small, well-tested personal finance ledger API: accounts, transactions and budgets.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-warnings=ExperimentalWarning tsx watch src/index.ts",
    "start": "node --no-warnings=ExperimentalWarning dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest",
    "seed": "NODE_OPTIONS=--no-warnings=ExperimentalWarning tsx scripts/seed.ts test/fixtures/seed.json",
    "fixture:generate": "NODE_OPTIONS=--no-warnings=ExperimentalWarning tsx scripts/generate-fixture.ts > test/fixtures/seed.json"
  },
  "dependencies": {
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
